{
  "schema": "agent-reel/qualification-budgets/1",
  "note": "Frozen V8 budgets. Declared from prior evidence (V2/V3/V4/V5/V6/V7) and requirements before any V8 measurement existed. Changing this file requires a user-approved amendment entry and a new pinned hash in TestBudgetsFrozen.",
  "budgets": [
    {
      "id": "B01",
      "metric": "Helper peak RSS per target (80x24 workloads)",
      "budget": "≤ 8 MiB",
      "scope": {
        "tier": "A",
        "scenarios": [
          "A.matrix"
        ],
        "workloads": [
          "W1",
          "W2",
          "W3",
          "W4",
          "W5",
          "W6",
          "W8",
          "W9"
        ],
        "targets": [
          1,
          10,
          32
        ],
        "timelines": [
          "matrix"
        ],
        "profile": "full"
      },
      "limits": [
        {
          "key": "B01",
          "metric": "helper.peak_rss",
          "perTarget": true,
          "comparator": "<=",
          "value": 8,
          "unit": "MiB",
          "basisKind": "measured-prior"
        }
      ],
      "basis": {
        "kinds": [
          "measured-prior"
        ],
        "cite": "V2 measured 2.5–2.6 MiB (×3)",
        "derivation": "docs/visual-recording-readout-benchmarks.md: ~2.5 MiB resident per 80x24 helper at 1/10/32 helpers (2.480-2.625 MiB/helper across the benchmark rows). 8 MiB / 2.6 MiB = 3.08."
      }
    },
